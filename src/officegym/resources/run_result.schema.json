{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficeGym measured episode result",
  "type": "object",
  "required": [
    "instance_id",
    "scenario_family_id",
    "repeat_id",
    "group",
    "split",
    "template_id",
    "depth_level",
    "perturbation_level",
    "env_version",
    "eval_grader_version",
    "dataset_manifest_hash",
    "budget_hash",
    "success",
    "infra_error",
    "fault_injected",
    "recovery_started",
    "duplicate_effects",
    "premature_completion",
    "declared_done",
    "generated_tokens",
    "input_tokens",
    "tool_calls",
    "wall_seconds",
    "sim_seconds",
    "model_version",
    "reward_version",
    "harness_version",
    "context_samples",
    "context_token_sum",
    "peak_context_tokens",
    "compression_trigger_count",
    "summary_model_calls",
    "summary_cache_hits",
    "compressed_context_count",
    "truncated_context_count",
    "context_metrics_version",
    "dependency_width"
  ],
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "scenario_family_id": {
      "type": "string"
    },
    "repeat_id": {
      "type": "integer",
      "minimum": 0
    },
    "group": {
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "id_test",
        "combo_test",
        "unseen_test"
      ]
    },
    "template_id": {
      "type": "string"
    },
    "depth_level": {
      "type": "integer"
    },
    "perturbation_level": {
      "type": "integer"
    },
    "env_version": {
      "type": "string"
    },
    "eval_grader_version": {
      "type": "string"
    },
    "dataset_manifest_hash": {
      "type": "string"
    },
    "budget_hash": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "infra_error": {
      "type": "boolean"
    },
    "fault_injected": {
      "type": "boolean"
    },
    "recovery_started": {
      "type": "boolean"
    },
    "duplicate_effects": {
      "type": "integer",
      "minimum": 0
    },
    "premature_completion": {
      "type": "boolean"
    },
    "declared_done": {
      "type": "boolean"
    },
    "generated_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "sim_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "example_only": {
      "const": false
    },
    "synthetic": {
      "const": false
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "reward_version": {
      "type": "string",
      "minLength": 1
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "context_samples": {
      "type": "integer",
      "minimum": 0
    },
    "context_token_sum": {
      "type": "integer",
      "minimum": 0
    },
    "peak_context_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "compression_trigger_count": {
      "type": "integer",
      "minimum": 0
    },
    "summary_model_calls": {
      "type": "integer",
      "minimum": 0
    },
    "summary_cache_hits": {
      "type": "integer",
      "minimum": 0
    },
    "compressed_context_count": {
      "type": "integer",
      "minimum": 0
    },
    "truncated_context_count": {
      "type": "integer",
      "minimum": 0
    },
    "context_metrics_version": {
      "type": "string",
      "minLength": 1
    },
    "dependency_width": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_freeze_path": {
      "type": "string",
      "minLength": 1
    },
    "dataset_freeze_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true,
  "description": "One row per planned run. Write explicit infra_error rows for exhausted retries. Keep full manifests/checkpoint hashes/seed/token logs in linked artifacts."
}

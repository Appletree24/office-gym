{
  "format": "project_intent_not_upstream_config",
  "framework": "verl",
  "algorithm": "grpo",
  "starting_checkpoint": "SET_TO_EXPORTED_SFT_HASH",
  "reference_checkpoint": "SAME_EXPORTED_SFT_HASH",
  "harness": "full",
  "compression_allowed": false,
  "crash_injection_allowed": false,
  "group_size": 4,
  "effective_groups_per_update": 8,
  "max_candidate_group_multiplier": 4,
  "insufficient_effective_groups": "skip_update_and_log",
  "same_actor_version_within_update": true,
  "learning_rate": 1e-06,
  "lora": {
    "rank": 16,
    "alpha": 32
  },
  "kl_coefficient": 0.001,
  "max_tool_calls": 24,
  "max_context_tokens": 8192,
  "smoke_updates": 5,
  "probe_updates": 20,
  "max_updates": 100,
  "token_in_token_out": true,
  "tool_result_loss_mask": 0,
  "reward": {
    "full_success": 1,
    "correct_with_soft_deviation": 0.3,
    "ordinary_failure": 0,
    "severe_violation": -1,
    "soft_rules_enabled": false,
    "milestones_enabled": false
  },
  "native_checkpoint_contract": {
    "trainer_use_v1": false,
    "ppo_epochs": 1,
    "ppo_mini_batch_size": "MATCH_data.train_batch_size",
    "async_save": false,
    "save_contents": [
      "model",
      "optimizer",
      "extra"
    ],
    "retain_all_checkpoints": true,
    "resume_mode": "disable",
    "evidence_root": "ABSOLUTE_LAUNCH_OUTPUT",
    "checkpoint_directory": "EVIDENCE_ROOT/checkpoints",
    "verl_checkout": "ABSOLUTE_PINNED_VERL_CHECKOUT",
    "source_lock": "officegym/training/verl_checkpoint_sources.json"
  },
  "native_policy_contract": {
    "reference_mode": "disable_fresh_RL_adapter_over_admitted_merged_SFT_base",
    "actor_rollout_ref.model.lora_rank": 16,
    "actor_rollout_ref.model.lora_alpha": 32,
    "actor_rollout_ref.model.lora_adapter_path": null,
    "actor_rollout_ref.model.lora.merge": false,
    "actor_rollout_ref.actor.use_kl_loss": true,
    "actor_rollout_ref.actor.kl_loss_coef": 0.001,
    "algorithm.use_kl_in_reward": false,
    "actor_rollout_ref.rollout.name": "vllm",
    "actor_rollout_ref.rollout.load_format": "auto",
    "actor_rollout_ref.rollout.layered_summon": true,
    "nested_lora_rank": "absent_or_zero_or_equal_to_model_lora_rank",
    "validation": "launch_and_native_driver_and_ray_task_before_worker_creation"
  }
}
